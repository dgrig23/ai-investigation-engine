# Copy this file to `.env` and fill in your own values. `.env` is git-ignored.

# --- Vector database (Qdrant) ---
# Leave QDRANT_URL empty to use the embedded local Qdrant (data/qdrant_local) - no server needed.
QDRANT_URL=
QDRANT_API_KEY=

# --- LLM providers (all have free tiers; only providers with a key are used) ---
# Order in LLM_PROVIDERS is the fallback order.
LLM_PROVIDERS=groq,cerebras,mistral,gemini
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# Optional model overrides (defaults in app/config.py)
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=gpt-oss-120b

# Optional: protects edits/deletes of the built-in demo corpora on the public deployment.
ADMIN_TOKEN=
